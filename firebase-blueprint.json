{
  "entities": {
    "Ecosystem": {
      "title": "User Ecosystem",
      "description": "Complete medical ecosystem containing doctor configuration, patients bank, recipes, indications, and reports for a given user.",
      "type": "object",
      "properties": {
        "identifier": { "type": "string", "description": "Normalized identifier or email" },
        "email": { "type": "string", "description": "Doctor's account email" },
        "ci": { "type": "string", "description": "Doctor's identity number" },
        "doctorConfig": { "type": "object", "description": "Active doctor configuration and design assets" },
        "colleagueProfiles": { "type": "array", "description": "List of associated colleague doctor profiles" },
        "patientBank": { "type": "array", "description": "Bank of saved patients for fast auto-fill" },
        "recipes": { "type": "array", "description": "Active and saved prescription recipes" },
        "report": { "type": "object", "description": "Medical report data" },
        "indications": { "type": "object", "description": "Indications sheet data" },
        "rest": { "type": "object", "description": "Medical rest certificate data" },
        "records": { "type": "array", "description": "Clinical histories" },
        "customDrugs": { "type": "array", "description": "Custom user drugs" },
        "paymentConfig": { "type": "object", "description": "Payment methods configuration" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp in milliseconds" }
      },
      "required": ["identifier", "updatedAt"]
    },
    "DoctorConfig": {
      "title": "Doctor Profile",
      "description": "Individual doctor configuration and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique doctor ID" },
        "doctorName": { "type": "string", "description": "Doctor full name" },
        "email": { "type": "string", "description": "Doctor email address" },
        "ci": { "type": "string", "description": "Identity card number" },
        "specialty": { "type": "string", "description": "Medical specialty" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "updatedAt": { "type": "number", "description": "Timestamp of last edit" }
      },
      "required": ["id"]
    },
    "PaymentConfig": {
      "title": "Payment Configuration",
      "description": "Central payment details for system subscriptions and billing",
      "type": "object",
      "properties": {
        "pagoMovil": { "type": "object", "description": "Pago movil details" },
        "binance": { "type": "object", "description": "Binance Pay details" },
        "zinli": { "type": "object", "description": "Zinli email" },
        "tasaBinanceUsd": { "type": "number", "description": "Exchange rate" },
        "updatedAt": { "type": "number", "description": "Timestamp of last change" }
      }
    },
    "DocumentRecord": {
      "title": "Saved Document Record",
      "description": "Shared document record for cross-device retrieval",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document ID" },
        "patientName": { "type": "string", "description": "Patient name" },
        "patientCI": { "type": "string", "description": "Patient ID number" },
        "date": { "type": "string", "description": "Issuance date string" },
        "type": { "type": "string", "description": "Document type" },
        "updatedAt": { "type": "number", "description": "Timestamp" }
      },
      "required": ["id", "patientName"]
    }
  },
  "firestore": {
    "/ecosystems/{docKey}": {
      "schema": "Ecosystem",
      "description": "User ecosystem store indexed by normalized key"
    },
    "/doctors/{doctorId}": {
      "schema": "DoctorConfig",
      "description": "Individual doctor profiles"
    },
    "/settings/payment_config": {
      "schema": "PaymentConfig",
      "description": "System payment settings"
    },
    "/documents/{docId}": {
      "schema": "DocumentRecord",
      "description": "Exported medical documents"
    }
  }
}
