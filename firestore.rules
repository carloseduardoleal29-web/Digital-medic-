rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Doctor profile rules (persists doctor profiles, logos, colors, fonts, stamps)
    match /doctors/{doctorId} {
      allow read, write: if request.auth != null && request.auth.uid == doctorId;
    }

    // Ecosystem document rules (persists doctor recipes, design studio configurations, clinical documents)
    match /ecosystems/{ecosystemId} {
      allow read, write: if request.auth != null;
    }

    // Saved medical prescriptions, reports, and records
    match /documents/{documentId} {
      allow read, write: if request.auth != null;
    }

    // App and payment configuration
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }
  }
}
